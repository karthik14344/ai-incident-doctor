# ---------------------------------------------------------------------------
# ai-incident-doctor - every setting the stack reads.
# Copy to .env and edit. .env is gitignored: never commit real keys.
# ---------------------------------------------------------------------------

# ===== The patient (KnowledgeAI) ============================================

# Where Ollama is. It is NOT part of docker compose. Two settings, because a
# process on the host and a process in a container reach it differently:
#
#   OLLAMA_BASE_URL             used by anything running on the host (local
#                               runs, the load generator, the doctor's evaluation)
#   CONTAINER_OLLAMA_BASE_URL   used by the patient containers
#
#   This laptop (Docker Desktop):  host: http://127.0.0.1:11434
#                                  containers: http://host.docker.internal:11434
#   Pavilion (Ollama on laptop):   both: http://<laptop-LAN-IP>:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTAINER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# How the gateway reaches the other services. In compose these are overridden
# with container names (http://ingestion:8001 ...). Values below are for a
# local run outside Docker.
INGESTION_SERVICE_URL=http://127.0.0.1:8001
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8002
LLM_SERVICE_URL=http://127.0.0.1:8003

# How tools on the HOST reach the stack (load generator, deploy smoke test,
# fault scripts, the evaluation harness). They must match the host ports below.
GATEWAY_URL=http://127.0.0.1:8000
ALERTMANAGER_URL=http://127.0.0.1:9093
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
ALERT_SINK_URL=http://127.0.0.1:9095
GRAFANA_URL=http://127.0.0.1:3000
DOCTOR_URL=http://127.0.0.1:8100

# ChromaDB. Leave CHROMA_HOST empty for a local run (embedded store in
# patient/chroma_data). In compose it is set to the chroma container.
CHROMA_HOST=
CHROMA_PORT=8000

# ===== The doctor ===========================================================
# Reasoning provider, through an OpenAI-compatible client: glm | gemini | groq
# | openai | ollama. The fallback is used when the primary fails (no key, rate
# limit exhausted, outage). Keys belong in .env only - never commit them.
DOCTOR_PROVIDER=glm
DOCTOR_MODEL=glm-4.6
DOCTOR_API_KEY=
# Optional: override the provider's base URL (e.g. https://open.bigmodel.cn/api/paas/v4 for GLM in China)
DOCTOR_BASE_URL=
DOCTOR_FALLBACK_PROVIDER=ollama
DOCTOR_FALLBACK_MODEL=llama3.2
DOCTOR_FALLBACK_API_KEY=
# Model calls allowed per diagnosis (retries and the repair round count).
DOCTOR_MAX_CALLS_PER_RUN=6
# Local-model budget. When the live doctor falls back to the SAME Ollama and
# model as the patient, match the patient's context (4096) so Ollama never
# reloads the model between them, and shrink the evidence to fit. Evaluation
# replays run offline and use the full 16384 / 6500.
DOCTOR_OLLAMA_NUM_CTX=16384
DOCTOR_MAX_PROMPT_TOKENS=6500
DOCTOR_MAX_COMPLETION_TOKENS=2500
# Diagnose new alerts automatically (true) or only on request (false).
DOCTOR_AUTO_DIAGNOSE=true
# Where the deploy log lives on the host (mounted read-only into the doctor).
RUNTIME_DIR=./runtime

# ===== The agent team (CodeFix AI, the separate AGAI project) =============
# Every report is handed to a Manager agent that delegates to Diagnoser, Fixer,
# Tester and PR agents (doctor/app/agents.py). Off when DOCTOR_AGENTS_URL is empty.
# Start it with:  sh deploy/agai/build.sh  then  docker compose --profile agents up -d
DOCTOR_AGENTS_URL=
# What a browser opens for the team's run page, e.g. http://<host>:8200
DOCTOR_AGENTS_PUBLIC_URL=
AGAI_IMAGE_TAG=
AGAI_HOST_PORT=8200
# Empty = AGAI's own models; /repo/deploy/agai/models.yaml = the free GLM flash models.
AGAI_MODELS_FILE=
# Z.AI key the team's models are billed to, and a GitHub token (contents + pull
# requests on this repo) for the PR agent. Never commit them.
ZAI_API_KEY=
AGAI_GITHUB_TOKEN=
AGAI_A2A_TOKEN=

# ===== Deployment ===========================================================
# Set by deploy/deploy.py on every deploy; only set by hand for a manual
# `docker compose up`. Images are always tagged with a git SHA.
IMAGE_TAG=
APP_GIT_SHA=
KB_VERSION=
IMAGE_PREFIX=aid

# ===== Monitoring and ML ops (compose) ======================================
GRAFANA_ADMIN_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# ===== Optional public link (compose profile "tunnel") ======================
# Leave both empty for a temporary trycloudflare.com URL. For a named tunnel,
# set the token and CLOUDFLARE_TUNNEL_ARGS=run
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ARGS=

# ===== Host ports (optional) ================================================
# Defaults are the container ports. Override when another project already
# uses them on this machine (then update the *_URL values above to match).
# GATEWAY_HOST_PORT=8000
# INGESTION_HOST_PORT=8001
# RETRIEVAL_HOST_PORT=8002
# LLM_HOST_PORT=8003
# CHROMA_HOST_PORT=8010
# FRONTEND_HOST_PORT=3001
# DOCTOR_HOST_PORT=8100
# PROMETHEUS_HOST_PORT=9090
# ALERTMANAGER_HOST_PORT=9093
# ALERT_SINK_HOST_PORT=9095
# GRAFANA_HOST_PORT=3000
# LOKI_HOST_PORT=3100
# ALLOY_HOST_PORT=12345
# CADVISOR_HOST_PORT=8080
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
