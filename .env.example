# ---------------------------------------------------------------------------
# ai-incident-doctor - every setting the stack reads.
# Copy to .env and edit. .env is gitignored: never commit real keys.
# ---------------------------------------------------------------------------

# ===== The patient (KnowledgeAI) ============================================

# Where Ollama is. It is NOT part of docker compose.
#   Windows laptop, stack in Docker Desktop:  http://host.docker.internal:11434
#   Pavilion reaching the laptop over Wi-Fi:  http://<laptop-LAN-IP>:11434
#   Local run outside Docker:                 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# How the gateway reaches the other services. In compose these are overridden
# with container names (http://ingestion:8001 ...). Values below are for a
# local run outside Docker.
INGESTION_SERVICE_URL=http://127.0.0.1:8001
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8002
LLM_SERVICE_URL=http://127.0.0.1:8003

# Public address of the gateway, used by the load generator and smoke tests.
GATEWAY_URL=http://127.0.0.1:8000

# ChromaDB. Leave CHROMA_HOST empty for a local run (embedded store in
# patient/chroma_data). In compose it is set to the chroma container.
CHROMA_HOST=
CHROMA_PORT=8000
