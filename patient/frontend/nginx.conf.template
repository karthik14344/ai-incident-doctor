# Rendered by the nginx image's envsubst step at container start.
# GATEWAY_UPSTREAM / DOCTOR_UPSTREAM come from compose - no addresses in here.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Resolve upstream names per request through Docker's embedded DNS, not
    # once at startup: containers are recreated (new IP) during deploys and
    # fault injection, and the doctor may start after the frontend.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway_upstream ${GATEWAY_UPSTREAM};
    set $doctor_upstream ${DOCTOR_UPSTREAM};

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Chat answers stream as server-sent events; buffering would hold every
        # token until the answer is complete.
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    location /doctor-api/ {
        rewrite ^/doctor-api/(.*)$ /$1 break;
        proxy_pass $doctor_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
